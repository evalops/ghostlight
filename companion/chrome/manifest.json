{
  "manifest_version": 3,
  "name": "Continue in Ghostlight",
  "description": "Continue selected Chrome tabs in Ghostlight and optionally mirror bookmarks or Reading List.",
  "version": "0.2.0",
  "minimum_chrome_version": "120",
  "permissions": ["activeTab", "alarms", "storage"],
  "optional_permissions": ["tabs", "bookmarks", "readingList"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Continue in Ghostlight",
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "incognito": "not_allowed"
}
