# Copy this file to runtime/.env before starting the stack.
# Replace every __GENERATE_AT_INSTALL__ value with an install-specific value.

CONTROL_PORT=8080
VIEWER_PORT=8081
GHOSTLIGHT_BIND_ADDRESS=127.0.0.1

# Use the Linux host address that the macOS client can reach.
GHOSTLIGHT_VIEWER_URL=http://127.0.0.1:8081
GHOSTLIGHT_VIEWER_HEALTH_URL=http://viewer:8080
GHOSTLIGHT_API_TOKEN=__GENERATE_AT_INSTALL__
GHOSTLIGHT_BRIDGE_TOKEN=__GENERATE_AT_INSTALL__
GHOSTLIGHT_LEASE_TTL_SECONDS=30

# Ghostlight publishes this source-locked Neko 3.1.5 derivative with fixed Debian packages and Go modules.
NEKO_IMAGE=ghcr.io/evalops/ghostlight-viewer@sha256:fe135f3553502c1f057fb707c8e9731220d7321376f2eff84b84b4f02a0f7280
NEKO_USER_PASSWORD=__GENERATE_AT_INSTALL__
NEKO_ADMIN_PASSWORD=__GENERATE_AT_INSTALL__
NEKO_DESKTOP_SCREEN=1920x1080@30
# 1080p60 is supported: set NEKO_DESKTOP_SCREEN=1920x1080@60 and change framerate=30/1
# to framerate=60/1 in NEKO_CAPTURE_VIDEO_PIPELINE below so the capture cap keeps up.

# Neko forces VP8 when no capture pipeline is configured, so H.264 (constrained
# baseline, 3072 kbps, zerolatency) needs both the codec and a matching pipeline.
# To revert to VP8: NEKO_CAPTURE_VIDEO_CODEC=vp8 and NEKO_CAPTURE_VIDEO_PIPELINE=
# left empty; the upstream default VP8 pipeline is implicit and cannot be selected
# through this variable.
NEKO_CAPTURE_VIDEO_CODEC=h264
NEKO_CAPTURE_VIDEO_PIPELINE=ximagesrc display-name={display} show-pointer=false use-damage=false ! video/x-raw,framerate=30/1 ! videoconvert ! queue ! video/x-raw,format=NV12 ! x264enc name=encoder threads=4 bitrate=3072 key-int-max=60 vbv-buf-capacity=3072 byte-stream=true tune=zerolatency speed-preset=veryfast ! h264parse config-interval=1 ! video/x-h264,stream-format=byte-stream,profile=constrained-baseline ! appsink name=appsink

# The same port is exposed for Neko's UDP and TCP WebRTC muxes.
WEBRTC_MUX_PORT=52000
NEKO_WEBRTC_UDPMUX=52000
NEKO_WEBRTC_TCPMUX=52000
# Server-side ICE lite suits this trusted-LAN deployment; full-ICE clients such as
# WKWebView remain compatible. Set to 0 only for symmetric full-ICE debugging.
NEKO_WEBRTC_ICELITE=1
# Set this to the Linux host IP when NAT or a routed LAN is involved.
NEKO_WEBRTC_NAT1TO1=__GENERATE_AT_INSTALL__

# Script defaults. Override these only when the control API changes its paths.
CONTROL_HEALTH_PATH=/healthz
CONTROL_READY_PATH=/readyz
VIEWER_HEALTH_PATH=/health
VIEWER_DISCOVERY_PATH=/v1/viewer
