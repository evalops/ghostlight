{
  "manifest_version": 3,
  "name": "Ghostlight Browser Agent",
  "description": "Reports Chromium tab state to the local Ghostlight control service.",
  "version": "0.1.0",
  "minimum_chrome_version": "116",
  "key": "",
  "permissions": [
    "alarms",
    "nativeMessaging",
    "tabs",
    "webNavigation"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "incognito": "not_allowed"
}
